---
import '../styles/global.css';
import { DISCORD_URL, bannerLook, fylki, jarldomMap, news, glowOf, texts, type BannerColors } from '../data/clan';
import { pictureSize } from '../lib/picture-size';

interface Props {
  title?: string;
  description?: string;
  /** The picture shown when the page is shared, e.g. on Discord. Without one, the picture set in the site panel. */
  image?: string;
  /** For a page search engines should leave out, such as the one for a missing address. */
  noindex?: boolean;
  /** A Fylki or Flokkr page in the colours of its banner. */
  colors?: BannerColors;
}

const {
  title,
  description = texts.google.description,
  image = texts.google.picture || '/img/og.jpg',
  noindex = false,
  colors,
} = Astro.props;
// The home page title and the description are what Google shows, set in the site panel (Texts, Google); they carry the
// words people search for, the clan's short name VSC too. Other pages lead with their own name.
const fullTitle = title ? `${title} · The Völsung Clan` : texts.google.title;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();
const ogSize = await pictureSize(image);
const isHome = Astro.url.pathname === '/';
// Events lead to the home page; the Jarldom, Ranks, Media and each Fylki are pages of their own, and so are News and
// the map once they are turned on in the site panel.
type NavLink = { href: string; label: string; sub?: NavLink[] };
const nav: NavLink[] = [
  { href: '/#events', label: 'Events' },
  { href: '/jarldom/', label: 'Jarldom', sub: fylki.map((f) => ({ href: `/fylki/${f.slug}/`, label: f.name })) },
  ...(jarldomMap.on ? [{ href: '/map/', label: 'Map' }] : []),
  { href: '/ranks/', label: 'Ranks' },
  { href: '/media/', label: 'Media' },
  ...(news.on ? [{ href: '/news/', label: 'News' }] : []),
];
const here = Astro.url.pathname.replace(/\/?$/, '/');
const current = (href: string) => (href === here ? 'page' : undefined);
// Tells search engines who the clan is and where to find it, for the site name and links in results.
const clanData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'The Völsung Clan', alternateName: 'VSC', url: Astro.site?.toString() },
    {
      '@type': 'Organization',
      name: 'The Völsung Clan',
      alternateName: 'VSC',
      url: Astro.site?.toString(),
      logo: new URL('/apple-touch-icon.png', Astro.site).toString(),
      image: ogImage,
      description,
      sameAs: [DISCORD_URL],
    },
    // The picture Google is asked to show beside the home page; it still picks one itself.
    { '@type': 'WebPage', url: canonical, name: fullTitle, primaryImageOfPage: { '@type': 'ImageObject', url: ogImage } },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <!-- Google shows an icon in its results only when it is a multiple of 48px. -->
    <link rel="icon" type="image/png" sizes="144x144" href="/favicon-144.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Völsung Clan" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {ogSize.width && <meta property="og:image:width" content={String(ogSize.width)} />}
    {ogSize.height && <meta property="og:image:height" content={String(ogSize.height)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0d0d0c" />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(clanData)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=New+Rocker&family=Noto+Sans+Runic&display=swap"
    />
    <script is:inline>
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
      }
      // Signed-in members are already on the Discord, so the "Join" buttons (marked data-join) are hidden for them from
      // the first paint. The nav script below takes the class off again if the sign-in turns out to have ended.
      if (/(?:^|;\s*)vsc_signed_in=1(?:;|$)/.test(document.cookie)) document.documentElement.classList.add('member');
    </script>
  </head>
  <body class:list={{ 'banner-poles': bannerLook.poles }}>
    <nav class="nav" aria-label="Main">
      <div class="wrap">
        <a class="brand" href="/"><i class="emblem" aria-hidden="true"></i>Völsung</a>
        <ul id="nav-links">
          {
            nav.map((n) => (
              <li class:list={[n.sub && 'has-sub']}>
                <a href={n.href} aria-current={current(n.href)}>{n.label}</a>
                {n.sub && (
                  <ul class="sub">
                    {n.sub.map((s) => (
                      <li><a href={s.href} aria-current={current(s.href)}>{s.label}</a></li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
          <li class="me">
            <a id="nav-account" href="/account/" aria-current={current('/account/')}>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M9 2.5h4.5v11H9M2 8h8M7 5l3 3-3 3" /></svg>Log in
            </a>
            <ul class="sub" id="nav-me">
              <li><a data-me="profile" hidden>Your profile</a></li>
              <li><a href="/account/" aria-current={current('/account/')}>Account</a></li>
              <li><button type="button" data-me="logout">Log out</button></li>
            </ul>
          </li>
        </ul>
        <a class="btn btn-gold" href={DISCORD_URL} target="_blank" rel="noopener" data-join>Join us</a>
        <button class="menu" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Menu">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
      </div>
    </nav>

    <main class:list={{ 'banner-colors': colors, tinted: colors?.glow }} style={colors && `--accent: ${colors.accent}; --glow: ${glowOf(colors)}`}>
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <span><span class="rune">ᚠ</span> The Völsung Clan (VSC) · Mount &amp; Blade II: Bannerlord</span>
        <span class="links">
          <a href={DISCORD_URL} target="_blank" rel="noopener">discord.gg/volsung-clan</a>
          <a href="/privacy/">Privacy</a>
          <a href="/admin/" rel="nofollow">Admin panel</a>
        </span>
      </div>
    </footer>
    <button class="to-top" type="button" aria-label="Back to the top" tabindex="-1">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>
    </button>

    <script>
      import { act, maybeSignedIn, whoAmI } from '../lib/members';
      import { plainName } from '../lib/names';

      const root = document.documentElement;

      // A member who is signed in sees their Discord picture and name in the nav instead of "Log in", which opens a
      // small menu with their profile, their account and logging out.
      const account = document.querySelector<HTMLAnchorElement>('#nav-account');
      const mine = account?.closest<HTMLElement>('.me');
      if (account && mine && maybeSignedIn()) {
        whoAmI().then(
          (me) => {
            if (!me) return root.classList.remove('member');
            const toggle = Object.assign(document.createElement('button'), { type: 'button', className: 'me-toggle', title: 'Your account' });
            toggle.setAttribute('aria-expanded', 'false');
            toggle.setAttribute('aria-controls', 'nav-me');
            toggle.append(
              Object.assign(document.createElement('img'), { src: me.avatar, alt: '', width: 22, height: 22 }),
              Object.assign(document.createElement('span'), { textContent: plainName(me.name) }),
            );
            toggle.insertAdjacentHTML('beforeend', '<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" /></svg>');
            const profile = `/members/${me.id}/`;
            if (location.pathname === '/account/' || location.pathname === profile) toggle.setAttribute('aria-current', 'page');
            account.replaceWith(toggle);
            mine.classList.add('in');

            const open = (on: boolean) => {
              mine.classList.toggle('open', on);
              toggle.setAttribute('aria-expanded', String(on));
            };
            toggle.addEventListener('click', () => open(!mine.classList.contains('open')));
            document.addEventListener('click', (e) => {
              if (!mine.contains(e.target as Node)) open(false);
            });
            document.addEventListener('keydown', (e) => {
              if (e.key === 'Escape') open(false);
            });

            // Profiles are made when the site is rebuilt, so a brand new member may not have one for up to an hour.
            fetch(profile, { method: 'HEAD' })
              .then((r) => {
                if (!r.ok) return;
                const link = mine.querySelector<HTMLAnchorElement>('[data-me="profile"]')!;
                link.href = profile;
                if (location.pathname === profile) link.setAttribute('aria-current', 'page');
                link.hidden = false;
              })
              .catch(() => {});

            const logout = mine.querySelector<HTMLButtonElement>('[data-me="logout"]')!;
            logout.addEventListener('click', async () => {
              logout.disabled = true;
              try {
                await act('logout');
                location.reload();
              } catch {
                location.href = '/account/';
              }
            });
          },
          () => {},
        );
      }

      // Reveal sections as they scroll into view (styles in global.css).
      if (root.classList.contains('motion')) {
        document.querySelectorAll('[data-stagger]').forEach((group) => {
          Array.from(group.children).forEach((child, i) => (child as HTMLElement).style.setProperty('--i', String(i)));
        });
        const reveal = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('is-in');
              reveal.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        document.querySelectorAll('[data-reveal], [data-stagger]').forEach((el) => reveal.observe(el));
      }

      // On a phone the links fold into a menu under the nav bar.
      const nav = document.querySelector<HTMLElement>('.nav');
      const menu = document.querySelector<HTMLButtonElement>('.nav .menu');
      const toggle = (open: boolean) => {
        nav?.classList.toggle('open', open);
        menu?.setAttribute('aria-expanded', String(open));
      };
      menu?.addEventListener('click', () => toggle(!nav?.classList.contains('open')));
      nav?.querySelectorAll('ul a').forEach((a) => a.addEventListener('click', () => toggle(false)));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') toggle(false);
      });

      // A back link to the page the visitor just came from steps back instead, to where they were on it.
      document.querySelectorAll<HTMLAnchorElement>('a[data-back]').forEach((a) =>
        a.addEventListener('click', (e) => {
          if (!document.referrer || history.length < 2) return;
          const from = new URL(document.referrer);
          if (from.origin !== location.origin || from.pathname !== a.pathname) return;
          e.preventDefault();
          history.back();
        }),
      );

      // Back to the top, once the page has been scrolled well down.
      const up = document.querySelector<HTMLButtonElement>('.to-top');
      if (up) {
        const show = () => {
          const shown = scrollY > innerHeight * 1.5;
          up.classList.toggle('shown', shown);
          up.tabIndex = shown ? 0 : -1;
        };
        addEventListener('scroll', show, { passive: true });
        show();
        up.addEventListener('click', () => scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }));
      }

      // Mark the nav link of the section in the middle of the screen.
      const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav ul a')).filter((a) => a.hash && a.pathname === location.pathname);
      const links = new Map(sectionLinks.map((a) => [a.hash.slice(1), a]));
      const spy = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const link = links.get(e.target.id);
            if (e.isIntersecting) link?.setAttribute('aria-current', 'location');
            else link?.removeAttribute('aria-current');
          }
        },
        { rootMargin: '-45% 0px -50% 0px' },
      );
      links.forEach((_, id) => {
        const section = document.getElementById(id);
        if (section) spy.observe(section);
      });
    </script>
  </body>
</html>

<style>
  .to-top {
    position: fixed;
    right: max(16px, env(safe-area-inset-right, 0px));
    bottom: max(16px, env(safe-area-inset-bottom, 0px));
    z-index: 20;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    padding: 0;
    background: color-mix(in srgb, var(--pitch) 88%, transparent);
    border: 1px solid var(--line);
    color: var(--gold);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.25s, transform 0.25s, visibility 0.25s, border-color 0.2s;
  }
  .to-top.shown { opacity: 1; visibility: visible; transform: none; }
  .to-top:hover { border-color: var(--gold); }
  .to-top svg { width: 22px; height: 22px; stroke: currentColor; stroke-width: 1.8; fill: none; }
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    view-transition-name: nav;
    background: color-mix(in srgb, var(--pitch) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line);
  }
  .nav .wrap { display: flex; align-items: center; gap: 20px; padding-block: 12px; }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font-family: var(--f-title);
    letter-spacing: 0.04em;
    font-size: 26px;
    line-height: 1;
  }
  .brand .emblem { width: 24px; }
  .nav ul {
    display: flex;
    gap: 22px;
    list-style: none;
    margin: 0 0 0 auto;
    padding: 0;
    font-family: var(--f-display);
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .nav ul a { position: relative; text-decoration: none; color: var(--ink); }
  .nav ul a:hover, .nav ul a[aria-current] { color: var(--gold); }
  .nav ul a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transition: transform 0.4s;
  }
  .nav ul a[aria-current]::after { transform: none; }
  /* The Fylki open under Jarldom; the gap above the list still counts as hovering it. */
  .nav .has-sub { position: relative; }
  .nav .has-sub:has([aria-current]) > a { color: var(--gold); }
  .nav .sub {
    display: none;
    position: absolute;
    top: 100%;
    left: -17px;
    margin: 18px 0 0;
    padding: 16px;
    gap: 14px;
    min-width: 210px;
    background: var(--pitch);
    border: 1px solid var(--line);
    white-space: nowrap;
  }
  .nav .sub::before { content: ""; position: absolute; inset: -19px 0 auto; height: 19px; }
  .nav .has-sub:hover .sub, .nav .has-sub:focus-within .sub { display: grid; }
  .menu { display: none; width: 40px; height: 40px; place-items: center; padding: 0; background: transparent; border: 1px solid var(--line); color: var(--ink); cursor: pointer; }
  .menu svg { width: 22px; height: 22px; stroke: currentColor; stroke-width: 1.6; fill: none; }
  .nav.open .menu { border-color: var(--gold); color: var(--gold); }
  /* A thin gold line under the nav fills as the page is read. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .nav::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -1px;
        height: 2px;
        background: var(--gold);
        transform-origin: left;
        animation-name: read;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
      }
    }
  }
  @keyframes read {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  /* "Log in" stands apart from the page links as an outlined button, without growing the bar. */
  .nav ul #nav-account { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; margin-block: -10px; border: 1px solid var(--line); transition: border-color 0.2s, color 0.2s; }
  .nav ul #nav-account:hover, .nav ul #nav-account[aria-current] { border-color: var(--gold); }
  .nav ul #nav-account::after { content: none; }
  #nav-account svg { width: 14px; height: 14px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  /* The signed-in member's menu opens on a click and sits under their name, against the right edge. */
  .nav .me { position: relative; }
  .nav .me:not(.in) .sub { display: none; }
  .nav .me.open .sub { display: grid; }
  .nav .me .sub { left: auto; right: -17px; min-width: 180px; }
  .nav .me .sub [hidden] { display: none; }
  /* The button with the member's name is made by the script, so its rules reach past this file's scoping. */
  .me :global(.me-toggle), .nav .me .sub button { font: inherit; letter-spacing: inherit; text-transform: inherit; color: var(--ink); background: none; border: 0; padding: 0; cursor: pointer; }
  .me :global(.me-toggle) { display: inline-flex; align-items: center; gap: 8px; }
  .me :global(.me-toggle:hover), .me :global(.me-toggle[aria-current]), .me.open :global(.me-toggle), .nav .me .sub button:hover { color: var(--gold); }
  .me :global(.me-toggle img) { flex: none; width: 22px; height: 22px; border-radius: 50%; margin-block: -4px; }
  .me :global(.me-toggle span) { max-width: 16em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (max-width: 1100px) {
    .nav ul { gap: 16px; }
    .me :global(.me-toggle span) { max-width: 7em; }
  }
  /* Just above the phone menu there is room only for the picture. */
  @media (max-width: 960px) and (min-width: 861px) {
    .me :global(.me-toggle span) { display: none; }
  }
  .me :global(.me-toggle svg) { flex: none; width: 10px; height: 10px; stroke: currentColor; stroke-width: 1.6; fill: none; transition: transform 0.2s; }
  .me.open :global(.me-toggle svg) { transform: rotate(180deg); }
  .nav .me .sub button:disabled { opacity: 0.5; cursor: wait; }
  .nav .btn { padding: 10px 16px; font-size: 12px; white-space: nowrap; }
  @media (max-width: 860px) {
    .nav .wrap { gap: 12px; }
    .nav ul { display: none; }
    .nav .btn { margin-left: auto; }
    .menu { display: grid; }
    :global(.member) .menu { margin-left: auto; }
    .nav.open #nav-links {
      display: grid;
      gap: 0;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin: 0;
      padding: 8px max(16px, env(safe-area-inset-left, 0px)) 18px;
      background: var(--pitch);
      border-bottom: 1px solid var(--line);
      font-size: 14px;
    }
    .nav.open #nav-links > li { padding: 12px 0; border-bottom: 1px solid var(--line); }
    .nav.open #nav-links > li:last-child { border-bottom: 0; }
    .nav.open .sub { display: grid; position: static; margin: 0; padding: 14px 0 2px 18px; gap: 14px; min-width: 0; background: none; border: 0; }
    .nav.open .sub::before { content: none; }
    .nav.open #nav-account { margin-block: 0; }
  }
  footer { border-top: 1px solid var(--line); padding-block: 28px; color: var(--muted); font-size: 15px; }
  footer .wrap { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; justify-content: space-between; }
  footer .links { display: flex; flex-wrap: wrap; gap: 12px 24px; }
</style>
