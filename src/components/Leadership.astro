---
import { lsRoles, type FylkiLeadership } from '../data/clan';
import type { Placed } from '../lib/clansmen';

interface Props {
  name: string;
  unit: 'Fylki' | 'Flokkr';
  /** The LS, with each person's Clansman on Discord where one was found (withDiscord in src/lib/clansmen.ts). */
  ls: Record<keyof FylkiLeadership, Placed[]>;
}

const { name, unit, ls } = Astro.props;

// The leaders open a message to them on Discord; the others open their profile on this site.
const linkOf = (role: keyof FylkiLeadership, m: Placed) =>
  m.id && (role === 'leaders' ? { href: `https://discord.com/users/${m.id}`, target: '_blank', rel: 'noopener', title: `Message ${m.name} on Discord` } : { href: `/members/${m.id}/` });
---

<div class="head" data-stagger>
  <p class="eyebrow">Leadership</p>
  <h2>Who leads {name}</h2>
</div>
<div class="ls" data-reveal>
  {
    lsRoles(unit).map((role) => (
      <div class="role">
        <header>
          <h3>{role.name}</h3>
          <p>{role.text}</p>
        </header>
        <div class="members">
          {ls[role.key].length ? (
            ls[role.key].map((m) => {
              const link = linkOf(role.key, m);
              const Tag = link ? 'a' : 'div';
              return (
                <Tag class:list={['member', { linked: link }]} {...link}>
                  {m.portrait ? (
                    <img src={m.portrait} alt={`Portrait of ${m.name}`} loading="lazy" />
                  ) : m.picture ? (
                    <img class="face" src={m.picture} alt="" width="64" height="64" loading="lazy" />
                  ) : (
                    <span class="emblem" aria-hidden="true" />
                  )}
                  <b>{m.name}</b>
                  {m.title && <span>{m.title}</span>}
                  {link && role.key === 'leaders' && <span class="dm">Message on Discord ↗</span>}
                </Tag>
              );
            })
          ) : (
            <p class="tba">To be announced</p>
          )}
        </div>
      </div>
    ))
  }
</div>

<style>
  .ls { display: grid; gap: 2px; background: var(--line); border: 1px solid var(--line); }
  .role { background: var(--pitch); display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 24px; padding: 22px; }
  .role header { display: grid; gap: 4px; align-content: start; }
  .role header p { color: var(--muted); font-size: 16px; }
  .members { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 16px; }
  .member { display: grid; gap: 6px; justify-items: start; align-content: start; color: inherit; text-decoration: none; }
  .member img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border: 1px solid var(--line); }
  .member img.face { width: 64px; height: 64px; aspect-ratio: 1; border-radius: 50%; margin-bottom: 4px; transition: border-color 0.2s; }
  .member .emblem { width: 28px; }
  .member b { font-family: var(--f-display); font-size: 15px; letter-spacing: 0.06em; transition: color 0.2s; }
  .member span:not(.emblem) { color: var(--muted); font-size: 15px; }
  .member span.dm { font-size: 13px; letter-spacing: 0.04em; color: var(--gold); }
  .linked:hover b, .linked:focus-visible b { color: var(--gold); }
  .linked:hover img, .linked:focus-visible img { border-color: var(--gold); }
  .tba { color: var(--muted); font-style: italic; }
  @media (max-width: 820px) { .role { grid-template-columns: 1fr; gap: 14px; } .members { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); } }
</style>
