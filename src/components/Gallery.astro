---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { GalleryImage } from '../data/clan';

interface Props {
  items: GalleryImage[];
}

const { items } = Astro.props;

// Photos sit in src/assets/gallery/ so the build can shrink them: a tile for the grid and a larger copy for the
// lightbox, both WebP. A photo uploaded straight from the game is fine.
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/*.{png,jpg,jpeg,webp,avif}', { eager: true });
const pictures = (
  await Promise.all(
    items.map(async (g) => {
      const file = files[g.src]?.default;
      if (!file) {
        console.warn(`[gallery] no picture at ${g.src}, skipped`);
        return null;
      }
      const tile = await getImage({ src: file, width: Math.min(file.width, g.size === 'normal' || !g.size ? 700 : 1000), format: 'webp', quality: 78 });
      // The large copy loads only when a photo is opened, so it can be sharp on big screens.
      const full = await getImage({ src: file, width: Math.min(file.width, 2560), format: 'webp', quality: 88 });
      return { ...g, tile: tile.src, full: full.src };
    }),
  )
).filter((p) => p !== null);
---

<div class="gallery" data-stagger>
  {
    pictures.map((g) => (
      <button type="button" class:list={[g.size === 'big' && 'g-big', g.size === 'wide' && 'g-wide']} data-src={g.full}>
        <img src={g.tile} alt={g.alt} loading="lazy" />
      </button>
    ))
  }
</div>

<style>
  /* Pictures fill gaps left by the big and wide ones, so any order makes a full grid. */
  .gallery { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 170px; grid-auto-flow: dense; gap: 8px; }
  .gallery button { padding: 0; border: 0; background: var(--pitch); cursor: zoom-in; overflow: hidden; }
  .gallery img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s; }
  .gallery button:hover img { transform: scale(1.04); }
  .g-big { grid-column: span 2; grid-row: span 2; }
  .g-wide { grid-column: span 2; }
  @media (max-width: 760px) { .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 130px; } }
</style>
