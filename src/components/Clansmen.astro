---
import type { Clansman } from '../lib/clansmen';

interface Props {
  name: string;
  members: Clansman[];
}

const { name, members } = Astro.props;
---

<div class="head" data-stagger>
  <p class="eyebrow">Members</p>
  <h2>The people of {name}</h2>
  <p>{members.length === 1 ? 'One Clansman' : `${members.length} Clansmen`} of {name}, as they are on the clan's Discord.</p>
</div>
<ul class="clansmen" data-reveal>
  {
    members.map((m) => (
      <li>
        {m.picture ? <img src={m.picture} alt="" width="40" height="40" loading="lazy" /> : <span class="emblem" aria-hidden="true" />}
        <span class="name">{m.name}</span>
      </li>
    ))
  }
</ul>

<style>
  .clansmen { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px 24px; }
  li { display: flex; align-items: center; gap: 12px; min-width: 0; }
  img { width: 40px; height: 40px; flex: none; border-radius: 50%; border: 1px solid var(--line); object-fit: cover; }
  .emblem { width: 24px; flex: none; margin: 0 8px; }
  .name { min-width: 0; overflow-wrap: anywhere; font-size: 17px; }
</style>
