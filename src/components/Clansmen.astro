---
import type { Profile } from '../lib/clansmen';
import { splitName } from '../lib/names';

interface Props {
  name: string;
  /** The people under the LS, by tier of the Ranks page (byTier in src/lib/clansmen.ts). */
  groups: { name: string; meaning: string; people: Profile[] }[];
}

const { name, groups } = Astro.props;
const count = groups.reduce((n, g) => n + g.people.length, 0);
---

<div class="head" data-stagger>
  <p class="eyebrow">Members</p>
  <h2>The people of {name}</h2>
  <p>{count === 1 ? 'One more Clansman' : `${count} more Clansmen`} of {name}, by rank, as they are on the clan's Discord.</p>
</div>
<div class="tiers" data-reveal>
  {
    groups.map((g) => (
      <div class="tier">
        <header>
          <h3>{g.name}</h3>
          <p>{g.meaning}</p>
        </header>
        <ul class="clansmen">
          {g.people.map((m) => {
            const { tag, name } = splitName(m.name);
            return (
              <li>
                <a href={`/members/${m.id}/`}>
                  {m.picture ? <img src={m.picture} alt="" width="40" height="40" loading="lazy" /> : <span class="emblem" aria-hidden="true" />}
                  <span class="who">
                    {tag && <small>{tag}</small>}
                    <span class="name">{name}</span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .tiers { display: grid; gap: 40px; }
  .tier { display: grid; gap: 18px; }
  .tier header { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .tier header p { color: var(--muted); font-size: 16px; }
  .clansmen { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px 24px; }
  li { min-width: 0; }
  a { display: flex; align-items: flex-start; gap: 12px; min-width: 0; color: inherit; text-decoration: none; }
  a:hover .name, a:focus-visible .name { color: var(--gold); }
  a:hover img { border-color: var(--gold); }
  img { width: 40px; height: 40px; flex: none; border-radius: 50%; border: 1px solid var(--line); object-fit: cover; }
  .emblem { width: 24px; flex: none; margin: 8px; }
  .who { display: grid; align-content: center; min-height: 40px; min-width: 0; line-height: 1.25; }
  .who small { font-size: 14px; letter-spacing: 0.04em; color: var(--muted); overflow-wrap: anywhere; }
  .name { min-width: 0; overflow-wrap: anywhere; font-size: 17px; }
</style>
