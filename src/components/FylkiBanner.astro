---
import Banner from './Banner.astro';
import { glowOf, type BannerColors } from '../data/clan';

interface Props {
  /** A Fylki, or a Flokkr with a slug that is unique across the site. */
  fylki: { slug: string; name: string; banner?: string; subtitle?: string; shape?: string; colors?: BannerColors };
  /** Makes the whole banner a link, for the Jarldom page. */
  href?: string;
  /** For a banner further down the page, so it does not hold up the pictures at the top. */
  lazy?: boolean;
}

const { fylki, href, lazy } = Astro.props;
// Same name on the Jarldom page and the Fylki page, so the banner morphs between them.
const morph = `view-transition-name: banner-${fylki.slug}`;
const Frame = href ? 'a' : 'div';
---

<Frame class:list={['bannerframe', { linked: href }]} href={href}>
  <Banner src={fylki.banner} alt={`Banner of ${fylki.name}`} shape={fylki.shape} glow={glowOf(fylki.colors)} lazy={lazy} label style={morph} />
  <b>{fylki.name}</b>
  {fylki.subtitle && <small>{fylki.subtitle}</small>}
</Frame>
