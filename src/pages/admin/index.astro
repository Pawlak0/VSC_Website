---
// The editors' panel. The page itself is static; signing in, loading and saving all happen in the browser
// (src/admin/panel.ts), with the editor's own GitHub token.
import '../../styles/global.css';
import '../../styles/jarldom-map.css';

const tokenPage = 'https://github.com/settings/tokens/new?scopes=public_repo&description=V%C3%B6lsung%20site%20panel';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Site panel · The Völsung Clan</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=EB+Garamond&family=New+Rocker&display=swap" />
  </head>
  <body class="admin">
    <section id="signin" hidden>
      <a class="logo" href="/">Völsung</a>
      <h1>Site panel</h1>
      <p>Edit the photos, videos, Fylki, news and map of volsungclan.com. Saving writes the change to the site's GitHub repository, and the site updates by itself.</p>
      <ol>
        <li>You need a GitHub account with access to the site's repository. Pawlak adds you on GitHub under the repository's Settings, Collaborators.</li>
        <li><a href={tokenPage} target="_blank" rel="noopener">Create a token on GitHub</a>. Leave <b>public_repo</b> ticked, pick when it expires, and press Generate token.</li>
        <li>Paste the token here. It stays in this browser only.</li>
      </ol>
      <form id="signin-form">
        <input name="token" type="password" autocomplete="off" spellcheck="false" placeholder="ghp_…" required />
        <label class="toggle"><input name="keep" type="checkbox" checked /> <span>Remember me on this device</span></label>
        <button class="btn btn-gold" type="submit">Sign in</button>
        <p id="signin-error" class="error" role="alert" hidden></p>
      </form>
    </section>

    <div id="app" hidden>
      <header class="top">
        <a class="logo" href="/" target="_blank" rel="noopener">Völsung</a>
        <nav id="tabs">
          <button type="button" data-tab="photos">Photos</button>
          <button type="button" data-tab="videos">Videos</button>
          <button type="button" data-tab="fylki">Fylki</button>
          <button type="button" data-tab="news">News</button>
          <button type="button" data-tab="map">Map</button>
          <button type="button" data-tab="texts">Texts</button>
        </nav>
        <div id="cols" class="cols" role="group" aria-label="Cards per row">
          <span>Per row</span>
          <button type="button" data-cols="1">1</button>
          <button type="button" data-cols="2">2</button>
          <button type="button" data-cols="4">4</button>
          <button type="button" data-cols="8">8</button>
        </div>
        <div class="who"><span id="who"></span><button id="signout" type="button" class="link">Sign out</button></div>
      </header>
      <main id="content"></main>
      <footer class="savebar">
        <span id="save-text">Everything is saved.</span>
        <button id="discard" type="button" class="btn btn-ghost" disabled>Discard</button>
        <button id="save" type="button" class="btn btn-gold" disabled>Save</button>
      </footer>
    </div>
    <div id="message" class="message" role="status" hidden></div>

    <script>
      import { start } from '../../admin/panel';
      start();
    </script>
  </body>
</html>

<style is:global>
  body.admin { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; font-size: 16px; line-height: 1.45; padding-bottom: 96px; }
  .admin h1, .admin h2, .admin h3, .admin h4 { font-family: var(--f-display); }
  .admin .logo { font-family: var(--f-title); font-size: 26px; color: var(--ink); text-decoration: none; }
  .admin a { color: var(--gold); }
  .admin [hidden] { display: none !important; }
  /* The site gives every section a tall padding; the panel's sections sit tight. */
  .admin #content section { padding-block: 0; }

  #signin { max-width: 560px; margin: 0 auto; padding: 64px 16px; display: grid; gap: 18px; }
  #signin h1 { font-size: 40px; }
  #signin ol { margin: 0; padding-left: 20px; display: grid; gap: 8px; color: var(--muted); }
  #signin form { display: grid; gap: 14px; }
  #signin form.busy { opacity: 0.6; pointer-events: none; }
  .admin .error { color: #e6957f; }

  .top { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; gap: 28px; padding: 10px 24px; background: var(--pitch); border-bottom: 1px solid var(--line); }
  #tabs { display: flex; gap: 4px; }
  #tabs button, .subtabs button { background: none; border: 0; border-bottom: 2px solid transparent; color: var(--muted); font: 700 14px var(--f-display); letter-spacing: 0.12em; text-transform: uppercase; padding: 10px 12px; cursor: pointer; }
  #tabs button.on, .subtabs button.on { color: var(--gold); border-bottom-color: var(--gold); }
  .cols { margin-left: auto; display: flex; align-items: center; gap: 4px; color: var(--muted); font-size: 13px; }
  .cols span { margin-right: 4px; letter-spacing: 0.08em; text-transform: uppercase; font-size: 12px; }
  .cols button { min-width: 30px; background: none; border: 1px solid var(--line); color: var(--muted); padding: 4px 8px; font: inherit; cursor: pointer; }
  .cols button:hover { color: var(--ink); }
  .cols button.on { border-color: var(--gold); color: var(--gold); }
  .who { margin-left: 24px; display: flex; gap: 14px; align-items: center; color: var(--muted); font-size: 14px; }

  #content { max-width: 1440px; margin: 0 auto; padding: 28px 24px; }
  .admin .bar { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; flex-wrap: wrap; margin-bottom: 8px; }
  .admin .bar h2 { font-size: 30px; }
  .admin .bar p, .admin .meta { color: var(--muted); max-width: 70ch; }
  .admin .meta { font-size: 14px; margin: 6px 0 16px; }
  .admin .status { color: var(--gold); }
  .admin .add { display: flex; gap: 8px; min-width: min(100%, 460px); }
  .admin .add input { flex: 1; }

  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  @media (max-width: 1150px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 820px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .grid { grid-template-columns: 1fr; } }
  .card { display: flex; flex-direction: column; background: var(--field); border: 1px solid var(--line); min-width: 0; }
  .card.on-home { border-color: var(--gold); }
  .card.dragging { opacity: 0.35; }
  .card.drop-before { box-shadow: -5px 0 0 var(--gold); }
  .card.drop-after { box-shadow: 5px 0 0 var(--gold); }
  .card.drop-above { box-shadow: 0 -5px 0 var(--gold); }
  .card.drop-below { box-shadow: 0 5px 0 var(--gold); }
  /* The "Per row" switch in the top bar. 4 is the layout above; phones keep theirs. */
  @media (min-width: 821px) {
    .admin[data-cols="1"] .grid:not(.picks) { grid-template-columns: minmax(0, 1fr); }
    .admin[data-cols="1"] .grid:not(.picks) .card { flex-direction: row; }
    .admin[data-cols="1"] .grid:not(.picks) .pic { flex: 0 0 380px; align-self: start; }
    .admin[data-cols="1"] .grid:not(.picks) .fields { flex: 1; align-content: start; max-width: 720px; }
    .admin[data-cols="2"] .grid:not(.picks) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .admin[data-cols="8"] .grid:not(.picks) { grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 10px; }
    .admin[data-cols="8"] .grid:not(.picks) .fields { padding: 8px; gap: 8px; }
  }
  .pic { position: relative; aspect-ratio: 16 / 10; background: var(--pitch); cursor: grab; overflow: hidden; }
  .pic img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pic .num { position: absolute; top: 6px; left: 6px; background: var(--shade); color: var(--ink); font-size: 12px; padding: 1px 7px; }
  .card.on-home .pic::after { content: "Home page"; position: absolute; top: 6px; right: 6px; background: var(--gold); color: var(--gold-ink); font: 700 11px var(--f-display); letter-spacing: 0.1em; text-transform: uppercase; padding: 2px 7px; }
  .admin .fields { display: grid; gap: 10px; padding: 12px; min-width: 0; }
  .admin .field { display: grid; gap: 4px; min-width: 0; }
  .admin .field .label { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .admin .field small, .banner-box small { font-size: 12px; color: var(--muted); }
  .admin .row { display: flex; gap: 10px; align-items: flex-end; flex-wrap: wrap; }
  .admin .row .field { flex: 1 1 120px; }
  .admin input:not([type="checkbox"]), .admin select, .admin textarea {
    width: 100%; background: var(--pitch); color: var(--ink); border: 1px solid var(--line); padding: 8px 10px; font: inherit; font-size: 15px; border-radius: 0;
  }
  .admin textarea { resize: vertical; }
  .admin textarea.saga { font-family: var(--f-body); font-size: 18px; line-height: 1.5; }
  .admin input:focus, .admin select:focus, .admin textarea:focus { outline: 1px solid var(--gold); border-color: var(--gold); }
  .admin .invalid { border-color: #d0644f !important; }
  .admin .toggle { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; padding-bottom: 8px; }
  .admin .toggle input { width: 18px; height: 18px; accent-color: var(--gold); }
  .admin .tools { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .admin .tools button { background: none; border: 1px solid var(--line); color: var(--ink); padding: 4px 10px; font-size: 13px; cursor: pointer; }
  .admin .tools button:hover:not(:disabled) { border-color: var(--gold); color: var(--gold); }
  .admin .tools button:disabled { opacity: 0.35; cursor: default; }
  .admin button.remove { color: #e6957f; }
  .admin button.link { background: none; border: 0; padding: 0; color: var(--gold); text-decoration: underline; cursor: pointer; font: inherit; font-size: 14px; }
  .admin .btn.small { padding: 6px 12px; font-size: 12px; }

  .subtabs { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; border-bottom: 1px solid var(--line); margin: 12px 0 24px; }
  .subtabs .link { margin-left: 12px; }
  .fylki-form h3 { font-size: 22px; margin: 34px 0 12px; }
  .panel-box { display: grid; gap: 14px; background: var(--field); border: 1px solid var(--line); padding: 16px; }
  .panel-box.basics { grid-template-columns: 190px minmax(0, 1fr); align-items: start; }
  .banner-box { display: grid; gap: 8px; justify-items: start; align-content: start; }
  .banner-pic { width: 150px; aspect-ratio: 3 / 4.4; background: var(--pitch); border: 1px solid var(--line); display: grid; place-items: center; overflow: hidden; }
  .banner-pic img { width: 100%; height: 100%; object-fit: contain; }
  .banner-pic.empty span { font: 700 12px var(--f-display); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .flokkr-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; align-items: start; }
  .flokkr-list > .btn { justify-self: start; align-self: center; }
  .flokkr-card { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 14px; background: var(--field); border: 1px solid var(--line); padding: 12px; }
  .flokkr-card .banner-pic { width: 72px; }
  .flokkr-card .fields { padding: 0; gap: 8px; justify-items: start; }
  .flokkr-card b { font: 700 16px var(--f-display); letter-spacing: 0.06em; }
  .flokkr-card small { font-size: 12px; color: var(--muted); }
  .crumbs { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; margin: -8px 0 20px; }
  .crumbs span { font: 700 14px var(--f-display); letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); }
  .ls { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 1100px) { .ls { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .ls, .panel-box.basics { grid-template-columns: 1fr; } }
  .role { display: grid; gap: 10px; align-content: start; justify-items: start; background: var(--field); border: 1px solid var(--line); padding: 12px; }
  .role h4 { font-size: 16px; letter-spacing: 0.06em; }
  .member { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 8px; width: 100%; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .member .fields { padding: 0; gap: 6px; }
  .member .tools, .member > .link { grid-column: 1 / -1; }
  .portrait { width: 48px; height: 64px; padding: 0; background: var(--pitch); border: 1px dashed var(--line); color: var(--muted); font-size: 20px; cursor: pointer; overflow: hidden; }
  .portrait img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .danger { margin-top: 48px; padding-top: 16px; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 16px 32px; align-items: start; justify-content: space-between; }
  .danger .promote { display: grid; gap: 6px; justify-items: start; max-width: 46ch; }
  .danger .promote small { font-size: 12px; color: var(--muted); }
  .danger .remove { background: none; border: 1px solid #6b2f25; padding: 8px 14px; cursor: pointer; }

  .admin .add.switch { min-width: 0; align-items: center; gap: 16px; }
  .admin .add.switch .toggle { padding-bottom: 0; }
  .page-box { display: grid; gap: 16px; margin: 16px 0 24px; padding: 20px; background: var(--field); border: 1px solid var(--line); }
  .page-box .bar { margin-bottom: 0; }
  .page-box .bar h3 { font-size: 24px; }
  .banner-settings { display: grid; justify-items: start; width: min(100%, 300px); }
  .banner-settings small { font-size: 12px; color: var(--muted); }
  .clan-banner-fold { margin: 0 0 20px; }
  .clan-banner-fold > summary { cursor: pointer; font: 700 15px var(--f-display); letter-spacing: 0.08em; color: var(--gold); padding: 6px 0; }
  .clan-banner-fold > .panel-box { margin-top: 8px; }
  /* The shapes of a banner, each a small banner to click, on a lighter ground so a black banner shows its cut too. */
  .shapes { display: flex; flex-wrap: wrap; gap: 8px; }
  .shape { display: grid; justify-items: center; align-content: start; gap: 6px; width: 70px; padding: 10px 4px 6px; background: #2b2924; border: 1px solid var(--line); color: var(--muted); cursor: pointer; }
  .shape .banner { width: 36px; }
  .admin .shape small { font-size: 11px; line-height: 1.2; text-align: center; }
  .shape:hover { border-color: var(--gold); color: var(--ink); }
  .shape.on { border-color: var(--gold); color: var(--gold); background: color-mix(in srgb, var(--gold) 16%, #2b2924); }
  .color-picks { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .color-pick { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; }
  .color-pick input[type='checkbox'] { width: 18px; height: 18px; accent-color: var(--gold); }
  .color-pick input[type='color'] { width: 44px; height: 30px; padding: 2px; background: var(--pitch); border: 1px solid var(--line); cursor: pointer; }
  .color-pick input:disabled { opacity: 0.4; cursor: default; }
  .page-box .bar .meta { margin: 4px 0 0; }
  .page-box .tools .toggle { padding: 0 0 0 12px; }
  .posts { display: grid; gap: 12px; }
  .post { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 16px; background: var(--field); border: 1px solid var(--line); padding: 12px; }
  .post .fields { padding: 0; }
  .post .tools .textlink { margin-left: auto; font-size: 14px; }
  .post-pic { display: grid; gap: 8px; align-content: start; }
  .post-pic .pic { cursor: default; display: grid; place-items: center; }
  .post-pic .pic.empty span { font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  @media (max-width: 640px) { .post { grid-template-columns: 1fr; } }

  /* The map as on the site (jarldom-map.css), with the list of banners beside it. */
  .map-edit { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 16px; align-items: start; }
  .map-stage { user-select: none; }
  .map-stage .map-pin, .map-stage .map-label { cursor: grab; touch-action: none; pointer-events: auto; }
  .map-stage .map-pin:active, .map-stage .map-label:active { cursor: grabbing; }
  .pin-list { display: grid; gap: 4px; max-height: 80vh; overflow: auto; padding: 12px; background: var(--field); border: 1px solid var(--line); }
  .pin-list h4 { font-size: 15px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
  .pin-row { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 4px 0; }
  .pin-row.sub { padding-left: 18px; grid-template-columns: 22px minmax(0, 1fr) auto; }
  .pin-row .banner, .pin-row .banner.main { width: 100%; }
  .pin-name { display: grid; min-width: 0; }
  .pin-name > span { font: 700 14px var(--f-display); letter-spacing: 0.04em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .admin .pin-name .toggle { padding: 2px 0 0; gap: 6px; font-size: 12px; color: var(--muted); }
  .admin .pin-name .toggle input { width: 14px; height: 14px; }
  .pin-row button { background: none; border: 1px solid var(--line); color: var(--ink); padding: 3px 9px; font-size: 12px; cursor: pointer; white-space: nowrap; }
  .pin-row button:hover { border-color: var(--gold); color: var(--gold); }
  .markers { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); gap: 12px; }
  .marker-card { display: grid; grid-template-columns: 90px minmax(0, 1fr); gap: 14px; padding: 12px; background: var(--pitch); border: 1px solid var(--line); }
  .marker-card .banner-pic { width: 90px; }
  .marker-card .banner-box small { display: none; }
  .marker-card .fields { padding: 0; }
  .label-row { display: grid; grid-template-columns: minmax(160px, 2fr) minmax(100px, 1fr) minmax(150px, 1fr) minmax(140px, 1fr) auto; gap: 12px; align-items: end; padding: 12px; background: var(--pitch); border: 1px solid var(--line); }
  .admin .label-row .tilt input { accent-color: var(--gold); width: 100%; height: 38px; padding: 0; border: 0; background: none; }
  .label-row .tools { padding-bottom: 8px; }
  @media (max-width: 900px) {
    .map-edit { grid-template-columns: 1fr; }
    .pin-list { max-height: none; }
    .label-row { grid-template-columns: 1fr 1fr; }
  }

  /* The Texts tab: a fold for each part of a page. */
  .texts-view { display: grid; gap: 10px; max-width: 1100px; }
  .texts-view > .bar { margin-bottom: 10px; }
  .text-part { background: var(--field); border: 1px solid var(--line); }
  .text-part > summary { cursor: pointer; padding: 14px 16px; font: 700 17px var(--f-display); letter-spacing: 0.06em; color: var(--gold); }
  .text-part[open] > summary { border-bottom: 1px solid var(--line); }
  .text-part > .panel-box { border: 0; background: none; }
  .text-part .meta { margin: 0; }
  .text-part h4 { font-size: 15px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-top: 8px; }
  .text-rows { display: grid; gap: 10px; justify-items: start; }
  .text-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14px; align-items: start; width: 100%; padding: 12px; background: var(--pitch); border: 1px solid var(--line); }
  .text-row > .body { display: grid; gap: 10px; min-width: 0; }
  .text-row > .tools { flex-direction: column; align-items: stretch; }
  .text-rows.inline .text-row { padding: 6px 6px 6px 10px; align-items: center; }
  .text-rows.inline .text-row > .tools { flex-direction: row; }
  .text-rows.cards .text-row > .body { grid-template-columns: 240px minmax(0, 1fr); gap: 14px; }
  .text-rows.cards .body > .fields { padding: 0; }
  .page-pic { display: grid; gap: 8px; justify-items: start; align-content: start; width: min(100%, 420px); }
  .page-pic.picture { width: min(100%, 240px); }
  .page-pic .pic { width: 100%; aspect-ratio: 16 / 9; cursor: default; display: grid; place-items: center; border: 1px solid var(--line); }
  .page-pic .pic.empty span { font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .page-pic small { font-size: 12px; color: var(--muted); }
  /* Roughly how Google lists the home page. */
  .google-preview { display: grid; gap: 4px; max-width: 640px; padding: 14px 16px; background: #1f1f1f; border: 1px solid var(--line); font-family: Arial, sans-serif; }
  .google-preview span:first-child { font-size: 13px; color: #bdc1c6; }
  .google-preview b { font-size: 20px; font-weight: 400; color: #99c3ff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .google-preview span:last-child { font-size: 14px; line-height: 1.5; color: #bdc1c6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 760px) { .text-rows.cards .text-row > .body { grid-template-columns: minmax(0, 1fr); } }

  dialog.picker { width: min(1100px, 92vw); max-height: 86vh; background: var(--pitch); color: var(--ink); border: 1px solid var(--line); padding: 20px; }
  dialog.picker::backdrop { background: rgba(0, 0, 0, 0.7); }
  dialog.picker h3 { margin-bottom: 14px; }
  .picks { grid-template-columns: repeat(5, minmax(0, 1fr)); margin-bottom: 16px; }
  .pick { padding: 0; border: 2px solid transparent; background: none; aspect-ratio: 16 / 10; cursor: pointer; overflow: hidden; }
  .pick img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pick.on { border-color: var(--gold); }

  .savebar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 6; display: flex; align-items: center; gap: 12px; padding: 12px 24px; background: var(--pitch); border-top: 1px solid var(--line); }
  .savebar #save-text { margin-right: auto; color: var(--muted); }
  body.dirty .savebar { border-top-color: var(--gold); }
  body.dirty #save-text { color: var(--ink); }
  .savebar .btn:disabled { opacity: 0.4; cursor: default; }
  .message { position: fixed; right: 24px; bottom: 82px; z-index: 7; max-width: 480px; padding: 12px 16px; background: var(--field); border: 1px solid var(--gold); }
  .message.error { border-color: #d0644f; color: #f0b3a3; }
