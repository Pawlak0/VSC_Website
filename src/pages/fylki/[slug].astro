---
import Base from '../../layouts/Base.astro';
import FylkiBanner from '../../components/FylkiBanner.astro';
import Gallery from '../../components/Gallery.astro';
import FlokkrList from '../../components/FlokkrList.astro';
import Saga from '../../components/Saga.astro';
import Lightbox from '../../components/Lightbox.astro';
import Leadership from '../../components/Leadership.astro';
import { DISCORD_URL, fylki, type Fylki } from '../../data/clan';

export function getStaticPaths() {
  return fylki.map((f) => ({ params: { slug: f.slug }, props: { fylki: f } }));
}

const { fylki: f } = Astro.props as { fylki: Fylki };
const others = fylki.filter((o) => o.slug !== f.slug);
---

<Base title={f.name} description={`${f.name}, a Fylki of The Völsung Clan in Mount & Blade II: Bannerlord.`}>
  <section class="fylki-hero">
    <div class="wrap intro">
      <FylkiBanner fylki={f} />
      <div class="txt" data-stagger>
        <p class="eyebrow">Fylki of The Völsung Clan</p>
        <h1>{f.name}</h1>
        <p class="lede">{f.description}</p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="head" data-stagger>
        <p class="eyebrow">Flokkr</p>
        <h2>The bands of {f.name}</h2>
      </div>
      <div class="flokkr-row" data-reveal>
        <FlokkrList fylki={f} />
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <Leadership name={f.name} unit="Fylki" ls={f.ls} />
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <Saga eyebrow="Saga" title={f.loreTitle ?? `The lore of ${f.name}`} paragraphs={f.lore} open={4} empty={`The saga of ${f.name} is yet to be written.`} />
    </div>
  </section>

  {
    f.gallery.length > 0 && (
      <section>
        <div class="wrap">
          <div class="head" data-stagger>
            <p class="eyebrow">Media</p>
            <h2>{f.name} in battle</h2>
          </div>
          <Gallery items={f.gallery} />
        </div>
      </section>
    )
  }

  <section class:list={[{ band: f.gallery.length > 0 }]}>
    <div class="wrap others" data-reveal>
      <p class="eyebrow">Other Fylki</p>
      <div class="links">
        {others.map((o) => <a class="textlink" href={`/fylki/${o.slug}/`}>{o.name}</a>)}
        <a class="textlink" href="/#jarldom">The whole Jarldom</a>
      </div>
      <a class="btn btn-gold" href={DISCORD_URL} target="_blank" rel="noopener">Join on Discord</a>
    </div>
  </section>
  {f.gallery.length > 0 && <Lightbox />}
</Base>

<style>
  .intro { display: flex; flex-wrap: wrap; align-items: center; gap: clamp(24px, 5vw, 64px); }
  .intro .txt { display: grid; gap: 16px; flex: 1 1 280px; min-width: 0; }
  h1 { font-size: clamp(36px, 7vw, 84px); font-weight: 900; letter-spacing: 0.05em; overflow-wrap: anywhere; }
  .lede { max-width: 50ch; font-size: clamp(19px, 2vw, 22px); color: var(--muted); }
  .flokkr-row :global(.flokkr) { justify-content: flex-start; --pennant: 120px; }
  .others { display: grid; gap: 20px; justify-items: start; }
  .links { display: flex; flex-wrap: wrap; gap: 20px; }
</style>
