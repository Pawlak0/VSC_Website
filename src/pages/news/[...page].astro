---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import { DISCORD_URL, news } from '../../data/clan';
import { pageSlug } from '../../lib/slug';

// Built only while News is turned on in the site panel; until then there is no /news/ page at all.
export function getStaticPaths() {
  return news.on ? [{ params: { page: undefined } }] : [];
}

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/*.{png,jpg,jpeg,webp,avif}', { eager: true });
const posts = await Promise.all(
  news.posts.map(async (p) => {
    const file = p.picture ? files[p.picture]?.default : undefined;
    const image = file ? (await getImage({ src: file, width: Math.min(file.width, 1400), format: 'webp', quality: 80 })).src : undefined;
    return { ...p, id: pageSlug(`${p.date} ${p.title}`), image };
  }),
);
const day = (d: string) =>
  /^\d{4}-\d{2}-\d{2}$/.test(d) ? new Date(`${d}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) : d;
---

<Base title="News" description="News and announcements of The Völsung Clan in Mount & Blade II: Bannerlord: events, promotions and word from the field.">
  <section>
    <div class="wrap">
      <div class="head" data-stagger>
        <p class="eyebrow">The Völsung Clan</p>
        <h1>News</h1>
        <p>Word from the Jarl and the Fylki: events, promotions and news from the field.</p>
      </div>
      {
        posts.length ? (
          <div class="posts">
            {posts.map((p) => (
              <article class="post" id={p.id} data-reveal>
                {p.date && <time datetime={p.date}>{day(p.date)}</time>}
                <h2>{p.title}</h2>
                {p.image && <img src={p.image} alt="" loading="lazy" />}
                {p.text.map((t) => <p>{t}</p>)}
              </article>
            ))}
          </div>
        ) : (
          <p class="none">No news yet.</p>
        )
      }
      <div class="links" data-reveal>
        <a class="textlink" href="/">Back to the home page</a>
        <a class="btn btn-gold" href={DISCORD_URL} target="_blank" rel="noopener">Join on Discord</a>
      </div>
    </div>
  </section>
</Base>

<style>
  h1 { font-size: clamp(36px, 7vw, 84px); font-weight: 900; letter-spacing: 0.05em; }
  .posts { display: grid; gap: 2px; background: var(--line); border: 1px solid var(--line); max-width: 860px; }
  .post { background: var(--pitch); display: grid; gap: 16px; padding: clamp(20px, 4vw, 36px); scroll-margin-top: 90px; }
  .post time { font-family: var(--f-display); font-size: 13px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); }
  .post h2 { font-size: clamp(24px, 3vw, 34px); }
  .post img { width: 100%; height: auto; border: 1px solid var(--line); }
  .post p { max-width: 68ch; }
  .none { color: var(--muted); font-style: italic; }
  .links { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; margin-top: 40px; max-width: 860px; }
</style>
