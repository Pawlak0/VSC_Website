---
import Base from '../layouts/Base.astro';
import BackLink from '../components/BackLink.astro';
import Lightbox from '../components/Lightbox.astro';
import Rank from '../components/Rank.astro';
import { pictureSize } from '../lib/picture-size';
import { DISCORD_URL, tiers, shieldwall, folk, leaders, texts } from '../data/clan';

const { hall } = texts.ranks;
const hallSize = await pictureSize(hall.picture);
---

<Base title="Ranks" description="The ranks of The Völsung Clan in Mount & Blade II: Bannerlord, from Thrall to Jarl, and the monthly promotion ceremony.">
  <section>
    <div class="wrap">
      <BackLink href="/" label="Back to the home page" />
      <div class="head" data-stagger>
        <p class="eyebrow">From Thrall to Jarl</p>
        <h1>Ranks</h1>
        {texts.ranks.text && <p>{texts.ranks.text}</p>}
      </div>
      <div class="leaders" data-stagger>
        {
          leaders.map((l) => (
            <div class="leader">
              <span class="rune" aria-hidden="true">{l.rune}</span>
              <b>{l.name}</b>
              <span>{l.role}</span>
            </div>
          ))
        }
      </div>
      <div class="tiers" data-reveal>
        {
          tiers.map((t) => (
            <div class="tier">
              <header>
                <h3>{t.name}</h3>
                <p>{t.meaning}</p>
              </header>
              <div class="ranks">
                {t.ranks.map((r) => (
                  <Rank rank={r} />
                ))}
              </div>
            </div>
          ))
        }
        <div class="tier">
          <header><h3>Skjaldborg</h3><p>The Shieldwall</p></header>
          <div>
            <div class="ladder">
              <div class="lh">Infantry</div><div class="lh">Archers</div><div class="lh">Civilians</div>
              {
                shieldwall.map((row) =>
                  [row.infantry, row.archers, row.civilians].map((r) => (
                    <div>
                      <Rank rank={r} placeholder />
                    </div>
                  )),
                )
              }
            </div>
            <div class="shared">
              <div class="lh">Every branch</div>
              {
                folk.map((r) => (
                  <div>
                    <Rank rank={r} />
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap feature">
      {
        hall.picture && (
          <figure data-reveal>
            <button type="button" class="zoom" data-src={hall.picture}><img src={hall.picture} alt={hall.alt ?? ''} width={hallSize.width} height={hallSize.height} loading="lazy" /></button>
          </figure>
        )
      }
      <div class="txt" data-stagger>
        {hall.eyebrow && <p class="eyebrow">{hall.eyebrow}</p>}
        <h2>{hall.title}</h2>
        {hall.text && <p>{hall.text}</p>}
      </div>
    </div>
    <div class="wrap links" data-reveal>
      <a class="textlink" href="/">Back to the home page</a>
      <a class="btn btn-gold" href={DISCORD_URL} target="_blank" rel="noopener" data-join>Join on Discord</a>
    </div>
  </section>

  <Lightbox />
</Base>

<style>
  h1 { font-size: clamp(36px, 7vw, 84px); font-weight: 900; letter-spacing: 0.05em; }
  .tiers { display: grid; gap: 2px; background: var(--line); border: 1px solid var(--line); }
  .tier { background: var(--pitch); display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 24px; padding: 22px; }
  .tier header { display: grid; gap: 4px; align-content: start; }
  .tier header h3 { font-size: 19px; }
  .tier header p { color: var(--muted); font-size: 16px; }
  .ranks { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 10px 18px; }
  .ladder { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--line); }
  .ladder > div { padding: 12px 14px; border-left: 1px solid var(--line); border-top: 1px solid var(--line); }
  .ladder > div:nth-child(3n + 1) { border-left: 0; }
  .lh { font-family: var(--f-display); font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); }
  .ladder > .lh { border-top: 0; }
  /* Folk and Thrall come before the branches split, so they run across all three columns. */
  .shared { border: 1px solid var(--line); border-top: 0; }
  .shared > div { padding: 12px 14px; border-top: 1px solid var(--line); }
  .shared > .lh { border-top: 0; }
  @media (max-width: 820px) { .tier { grid-template-columns: 1fr; gap: 14px; } }
  /* Three branch columns are too narrow on a phone: list Warriors, then Archers, then Civilians. */
  @media (max-width: 560px) {
    .ladder { grid-template-columns: minmax(0, 1fr); }
    .ladder > div { border-left: 0; }
    .ladder > :nth-child(3n + 1) { order: 1; }
    .ladder > :nth-child(3n + 2) { order: 2; }
    .ladder > :nth-child(3n + 3) { order: 3; }
    .ladder > .lh:not(:first-child) { border-top: 1px solid var(--line); }
  }

  .leaders { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-bottom: 28px; }
  .leader { border: 1px solid var(--line); padding: 16px; display: grid; gap: 6px; background: var(--field); }
  .leader .rune { font-size: 22px; }
  .leader b { font-family: var(--f-display); letter-spacing: 0.06em; }
  .leader span { color: var(--muted); font-size: 15px; }
  @media (max-width: 820px) { .leaders { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .feature { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: center; }
  .feature figure { margin: 0; border: 1px solid var(--line); padding: 8px; background: var(--field); }
  .feature img { display: block; width: 100%; height: auto; }
  .feature .zoom { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; overflow: hidden; }
  .feature .zoom img { transition: transform 0.5s; }
  .feature .zoom:hover img { transform: scale(1.03); }
  .feature .txt { display: grid; gap: 16px; }
  @media (max-width: 820px) { .feature { grid-template-columns: 1fr; } }
  /* The great hall unrolls from the top, like a banner being lowered. */
  :global(.motion) .feature figure[data-reveal] { opacity: 1; transform: none; clip-path: inset(0 0 100% 0); transition: clip-path 1.2s cubic-bezier(0.7, 0, 0.2, 1); }
  :global(.motion) .feature figure[data-reveal].is-in { clip-path: inset(0); }

  .links { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; margin-top: clamp(48px, 6vw, 72px); }
</style>
