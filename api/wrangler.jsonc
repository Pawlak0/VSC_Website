// The clan's API on Cloudflare Workers, at api.volsungclan.com. GitHub Actions deploys it (.github/workflows/api.yml)
// and passes in the secrets, DISCORD_CLIENT_SECRET, DISCORD_BOT_TOKEN and SITE_REBUILD_TOKEN; they are never written here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vsc-api",
  "main": "src/index.ts",
  "tsconfig": "tsconfig.json",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "api.volsungclan.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Every hour: rebuild the website, drop old sessions, check that members still have the role, delete accounts of
  // those who left.
  "triggers": { "crons": ["23 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vsc-members",
      // The deploy looks the database up by name (creating it in the EU the first time) and fills this in.
      "database_id": "set-by-deploy",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SITE": "https://volsungclan.com",
    "API": "https://api.volsungclan.com",
    "COOKIE_DOMAIN": "volsungclan.com",
    "DISCORD_CLIENT_ID": "1517891087144976434",
    "DISCORD_GUILD_ID": "1309581602619129948",
    "MEMBER_ROLE_ID": "1309592103646531615",
    "DISCORD_API": "https://discord.com/api/v10",
    "DISCORD_AUTHORIZE": "https://discord.com/oauth2/authorize",
    "GITHUB_API": "https://api.github.com",
    "SITE_REPO": "Pawlak0/VSC_Website",
    "SITE_WORKFLOW": "deploy.yml"
  }
}
